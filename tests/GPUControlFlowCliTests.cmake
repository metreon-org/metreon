file(MAKE_DIRECTORY "${WORK_DIR}/tmp/gpu")
get_filename_component(stem "${INPUT}" NAME_WLE)
set(artifact "${WORK_DIR}/tmp/gpu/${stem}.mlir")
if(NOT MLIR_ENABLED)
    file(WRITE "${artifact}" "previous artifact\n")
    execute_process(COMMAND "${COMPILER}" --emit=gpu "${INPUT}"
        WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
    file(READ "${artifact}" previous)
    if(result EQUAL 0 OR NOT error MATCHES "METREON_ENABLE_MLIR=ON" OR NOT previous STREQUAL "previous artifact\n")
        message(FATAL_ERROR "disabled GPU emission did not preserve previous output: ${error}")
    endif()
    return()
endif()
foreach(mode file stdin no_optimization)
    set(input "${INPUT}")
    set(output_stem "${stem}")
    set(extra)
    if(mode STREQUAL stdin)
        set(input "-")
        set(output_stem stdin)
    elseif(mode STREQUAL no_optimization)
        set(extra --no-optimization)
    endif()
    execute_process(COMMAND "${COMPILER}" --emit gpu ${extra} "${input}"
        INPUT_FILE "${INPUT}" WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "" OR
       NOT output STREQUAL "GPU MLIR written to tmp/gpu/${output_stem}.mlir\n")
        message(FATAL_ERROR "GPU emission failed: ${result} ${output} ${error}")
    endif()
    set(current "${WORK_DIR}/tmp/gpu/${output_stem}.mlir")
    file(READ "${current}" text)
    foreach(required "gpu.module" "gpu.func @work" "affine.for" "affine.if" "scf.for" "scf.while" "scf.if" "metreon.device_body")
        if(NOT text MATCHES "${required}")
            message(FATAL_ERROR "GPU output is missing ${required}")
        endif()
    endforeach()
    execute_process(COMMAND "${INSPECTOR}" "${current}" -o "${WORK_DIR}/roundtrip.mlir"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "GPU MLIR did not round-trip: ${error}")
    endif()
endforeach()
# Backend rejection after successful GraphIR validation preserves the artifact.
file(MAKE_DIRECTORY "${WORK_DIR}/unsupported")
set(unsupported "${WORK_DIR}/unsupported/${stem}.mtr")
file(WRITE "${unsupported}" "context Gpu::Thread grants {} gpu; kernel work(@cx: gpu; data: buffer<gpu::global>) { return; }")
file(READ "${artifact}" before)
execute_process(COMMAND "${COMPILER}" --emit=gpu "${unsupported}"
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(READ "${artifact}" after)
if(result EQUAL 0 OR NOT output STREQUAL "" OR NOT before STREQUAL after OR
   NOT error MATCHES "extent, layout and access contract")
    message(FATAL_ERROR "GPU target rejection did not preserve output: ${error}")
endif()
