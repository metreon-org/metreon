file(MAKE_DIRECTORY "${WORK_DIR}")
if(NOT MLIR_ENABLED)
    execute_process(COMMAND "${COMPILER}" --emit=mlir "${INPUT}"
        WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "METREON_ENABLE_MLIR=ON")
        message(FATAL_ERROR "frontend-only build must diagnose unavailable MLIR: ${error}")
    endif()
    return()
endif()

foreach(mode file stdin no_optimization)
    set(input "${INPUT}")
    set(stem procedures)
    set(extra)
    if(mode STREQUAL stdin)
        set(input "-")
        set(stem stdin)
    elseif(mode STREQUAL no_optimization)
        set(extra --no-optimization)
    endif()
    execute_process(COMMAND "${COMPILER}" --emit mlir ${extra} "${input}"
        INPUT_FILE "${INPUT}" WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "")
        message(FATAL_ERROR "MLIR emission failed: ${error}")
    endif()
    if(NOT output STREQUAL "MLIR written to tmp/mlir/${stem}.mlir\n")
        message(FATAL_ERROR "unexpected output notification: ${output}")
    endif()
    set(artifact "${WORK_DIR}/tmp/mlir/${stem}.mlir")
    file(READ "${artifact}" mlir)
    foreach(expected "metreon.context" "metreon.resource" "metreon.transition_decl" "deferred_body")
        if(NOT mlir MATCHES "${expected}")
            message(FATAL_ERROR "missing semantic structure ${expected}")
        endif()
    endforeach()
    execute_process(COMMAND "${INSPECTOR}" "${artifact}" -o "${WORK_DIR}/roundtrip.mlir"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "registered dialect round-trip failed: ${error}")
    endif()
endforeach()

# A frontend failure must leave the previous artifact intact.
set(invalid "${WORK_DIR}/procedures.mtr")
file(WRITE "${invalid}" "procedure broken() -> void { missing(); }")
file(READ "${WORK_DIR}/tmp/mlir/procedures.mlir" before)
execute_process(COMMAND "${COMPILER}" --emit=mlir "${invalid}"
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
file(READ "${WORK_DIR}/tmp/mlir/procedures.mlir" after)
if(result EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "failed compilation modified the previous MLIR artifact")
endif()
