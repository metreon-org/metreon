file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${COMPILER}" --emit=ptx --arch sm_89 "${INPUT}"
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0 OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "PTX compilation failed: ${result} ${stdout} ${stderr}")
endif()
foreach(stage graphir mlir gpu nvvm ptx)
    if(stage STREQUAL "graphir")
        set(extension graphir)
    elseif(stage STREQUAL "ptx")
        set(extension ptx)
    else()
        set(extension mlir)
    endif()
    set(path "${WORK_DIR}/tmp/${stage}/vector_add.${extension}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "missing intermediate artifact: ${path}")
    endif()
    if(extension STREQUAL "mlir")
        execute_process(COMMAND "${INSPECTOR}" "${path}" -o /dev/null
            RESULT_VARIABLE result ERROR_VARIABLE stderr)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "invalid ${stage} artifact: ${stderr}")
        endif()
    endif()
endforeach()
file(READ "${WORK_DIR}/tmp/mlir/vector_add.mlir" semantic)
file(READ "${WORK_DIR}/tmp/gpu/vector_add.mlir" primary)
file(READ "${WORK_DIR}/tmp/nvvm/vector_add.mlir" nvvm)
file(READ "${WORK_DIR}/tmp/ptx/vector_add.ptx" ptx)
file(READ "${WORK_DIR}/tmp/ptx/vector_add.abi.json" manifest)
if(NOT semantic MATCHES "metreon.device_intrinsic" OR NOT semantic MATCHES "contexts_only" OR
    NOT primary MATCHES "gpu.thread_id" OR NOT primary MATCHES "memref.load" OR primary MATCHES "metreon\\." OR
    NOT nvvm MATCHES "nvvm.read.ptx.sreg.tid.x" OR NOT nvvm MATCHES "llvm.fadd" OR
    NOT ptx MATCHES "[.]entry vector_add" OR NOT ptx MATCHES "[.]target sm_89" OR
    NOT manifest MATCHES "expanded_rank_one")
    message(FATAL_ERROR "missing real device lowering or ABI information")
endif()
# A failed compile must leave the last successful assembly untouched.
file(READ "${INPUT}" source)
string(REPLACE "gpu_load, gpu_store" "gpu_store" invalid "${source}")
file(WRITE "${WORK_DIR}/vector_add.mtr" "${invalid}")
execute_process(COMMAND "${COMPILER}" --emit=ptx "${WORK_DIR}/vector_add.mtr"
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE stderr)
if(result EQUAL 0 OR NOT stderr MATCHES "gpu_load")
    message(FATAL_ERROR "missing grant did not fail: ${result} ${stderr}")
endif()
file(READ "${WORK_DIR}/tmp/ptx/vector_add.ptx" preserved)
if(NOT preserved STREQUAL ptx)
    message(FATAL_ERROR "failed compilation overwrote PTX")
endif()
execute_process(COMMAND "${COMPILER}" --emit=ptx --arch sm_9999 "${INPUT}"
    WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result ERROR_VARIABLE stderr)
if(result EQUAL 0 OR NOT stderr MATCHES "unsupported")
    message(FATAL_ERROR "unsupported GPU architecture was accepted: ${stderr}")
endif()
