// Metreon host execution-context declarations.
context Host::Process grants {
    allocate,
    sleep,
    block,
    host_io
} process_ctx;

context Host::SoftIrq grants {
    atomic,
    mmio,
    defer<Host::Process>
} softirq_ctx;

context Host::HardIrq<I: Irq> grants {
    atomic,
    mmio,
    irq_ack<I>,
    defer<Host::SoftIrq>
} harirq_ctx;

context Host::Callback<S: StreamId> grants {
    atomic,
    defer<Host::Process>
} host_callback_ctx;

// A concrete GPU thread context. Its authority set is intentionally empty
// until operations for this context are specified.
context Gpu::Thread<D, U> grants {
} gpu_thread;

// A specialized GPU execution context. Concrete nested arguments are retained
// as part of the context type rather than lowered as context variables.
context Gpu::PersistentWorker<D, Uniform<Block>> grants {
    gpu_persistent_work
} persistent_worker;

// Transport queue authority is metadata-only for now. The grants record the
// operations this context is permitted to request at compile time.
context Transport::TxQueue<N: Nic, Q: Queue> grants {
    net_dma_submit,
    net_completion,
    transport_cancel
} transport_ctx;

// Clocked FPGA stream authority; the clock and port are compile-time metadata.
context Fpga::DataflowStage<fpga::clk0> grants {
    fifo_reserve<port::Output>,
    stream_enqueue<port::Output>,
    clock_wait<fpga::clk0>
} writer_ctx;

// TPU execution authority; grant arguments retain spaces, completion and scope.
context Tpu::TensorCore grants {
    dma_copy<tpu::hbm, tpu::vmem>,
    await_completion<tpu::LocalDma>,
    tensor_compute<bf16>,
    semaphore_signal<tpu::core>
} tpu_core;
